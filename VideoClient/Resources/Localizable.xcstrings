    "Добавьте API-ключ TMDB в настройках, чтобы подтянуть постеры и описания.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a TMDB API key in the settings to pull posters and descriptions."
